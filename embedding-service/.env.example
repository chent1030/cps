# Server
HOST=0.0.0.0
PORT=8008
WORKERS=1

# Auth. Leave empty to disable auth, but production should set a strong key.
API_KEY=change-me

# HuggingFace local model path or repo id.
MODEL_PATH=/data/models/siglip2-so400m-patch14-384
MODEL_NAME=google/siglip2-so400m-patch14-384
MODEL_VERSION=siglip2-v1

# Device options:
# - auto: cuda if available, otherwise cpu
# - cpu
# - cuda
# - cuda:0
DEVICE=auto

# Optional GPU selection. If set, it must be applied before Python starts.
# Example: CUDA_VISIBLE_DEVICES=1 makes physical GPU 1 visible as cuda:0.
# Put this in systemd/docker/shell environment, not inside Python after startup.
CUDA_VISIBLE_DEVICES=

# Embedding behavior
NORMALIZE_EMBEDDINGS=true
MAX_BATCH_SIZE=8
ENABLE_ZERO_SHOT=true
REQUEST_TIMEOUT_SECONDS=30

# Optional CORS for browser-side calls. Use comma-separated origins.
CORS_ORIGINS=
